#!/usr/bin/env sh
set -eu

cd "$(dirname "$0")/.."

APP_ENV="${1:-}"

if [ -z "$APP_ENV" ]; then
    branch=$(git rev-parse --abbrev-ref HEAD)
    case "$branch" in
        main) APP_ENV=production ;;
        staging) APP_ENV=staging ;;
        *)
            echo "Cannot infer environment from branch '$branch'. Usage: $0 <staging|production>" >&2
            exit 1
            ;;
    esac
fi

case "$APP_ENV" in
    staging|production) ;;
    *)
        echo "Invalid environment '$APP_ENV'. Usage: $0 <staging|production>" >&2
        exit 1
        ;;
esac

export APP_ENV

echo "==> Building luismeirelles/hermes:${APP_ENV}"
docker compose -f compose.deploy.yml build app

echo "==> Pushing luismeirelles/hermes:${APP_ENV}"
docker compose -f compose.deploy.yml push app
