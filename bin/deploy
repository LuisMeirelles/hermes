#!/usr/bin/env sh
set -eu

cd "$(dirname "$0")/.."

if [ ! -f .env ]; then
    echo ".env not found in $(pwd) — run this from the deploy directory for this environment." >&2
    exit 1
fi

APP_ENV=$(grep -E '^APP_ENV=' .env | cut -d '=' -f2-)

case "$APP_ENV" in
    production) branch=main ;;
    staging) branch=staging ;;
    *)
        echo "Unknown APP_ENV='$APP_ENV' in .env (expected 'staging' or 'production')." >&2
        exit 1
        ;;
esac

APP_URL=$(grep -E '^APP_URL=' .env | cut -d '=' -f2-)
APP_HOST=$(echo "$APP_URL" | sed -E 's#^[a-zA-Z]+://##; s#[:/].*##')

if [ -z "$APP_HOST" ]; then
    echo "Could not extract a host from APP_URL='$APP_URL' in .env." >&2
    exit 1
fi

export APP_HOST

echo "==> Deploying ${APP_ENV} (branch ${branch}) as ${APP_HOST}"

git fetch --depth 1 origin "$branch"
git reset --hard "origin/$branch"

docker compose -f compose.deploy.yml pull
docker compose -f compose.deploy.yml up -d
